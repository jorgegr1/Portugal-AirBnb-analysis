# Copy to .env and fill in values for your environment.

# --- Local Spark ---
SPARK_DRIVER_MEMORY=4g
SPARK_LOCAL_DIR=/tmp/spark-local
PYSPARK_PYTHON=python

# --- Inside Airbnb (only used if re-downloading raw CSVs) ---
INSIDE_AIRBNB_BASE_URL=https://data.insideairbnb.com
SNAPSHOT_DATE=2025-06-XX

# --- Google Cloud / Dataproc (benchmark phase) ---
GCP_PROJECT=your-gcp-project-id
GCP_REGION=europe-west1
GCS_BUCKET=egd-airbnb-bucket
DATAPROC_IMAGE_VERSION=2.2-debian12
DATAPROC_MACHINE_TYPE=n2-standard-4
